# Copy to .env and fill in. .env is gitignored and must never be committed
# (SPEC §13). Model ids live here too, so swapping a retired free-tier model is
# a one-line change rather than a code edit (SPEC §7).

# Groq -- the first provider wired up end to end (SPEC §14 step 5).
# Model ids: https://console.groq.com/docs/models
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Gemini, via its OpenAI-compatible endpoint.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenRouter -- pick a free-tier-eligible model id (SPEC §7).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
